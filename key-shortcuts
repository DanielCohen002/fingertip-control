#!/usr/bin/env python3
"""Fingertip Control: remap F-keys and mouse buttons to simple actions on Linux Mint (Cinnamon, X11)."""
import ast
import json
import os
import subprocess
import sys

CONFIG_DIR = os.path.expanduser("~/.config/key-shortcuts")
CONFIG = os.path.join(CONFIG_DIR, "config.json")
XBINDKEYS_RC = os.path.join(CONFIG_DIR, "xbindkeysrc")
AUTOSTART = os.path.expanduser("~/.config/autostart/fingertip-control.desktop")
KB_ROOT = "org.cinnamon.desktop.keybindings"
KB_PATH = "/org/cinnamon/desktop/keybindings/custom-keybindings/"
PREFIX = "keyshortcut"
VERSION = "1.1.1"

NONE = "None (leave as is)"
ACTIONS = {
    NONE: None,
    "Play / Pause": "playerctl play-pause",
    "Next track": "playerctl next",
    "Previous track": "playerctl previous",
    "Stop": "playerctl stop",
    "Mute / unmute speakers": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "Volume up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "Volume down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "Mute / unmute mic": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "Mic volume up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
    "Mic volume down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
    "Copy": "xdotool key ctrl+c",
    "Paste": "xdotool key ctrl+v",
    "Undo": "xdotool key ctrl+z",
    "Browser back": "xdotool key alt+Left",
    "Browser forward": "xdotool key alt+Right",
    "Middle click": "xdotool click 2",
    "Double click": "xdotool click --repeat 2 --delay 60 1",
    "Disable this button": "true",
}
KEYS = [f"F{i}" for i in range(1, 13)]
MOUSE = {"Middle button": 2, "Back button": 8, "Forward button": 9}  # X11 button numbers
DEFAULTS = {
    "keys": [
        {"key": "F5", "action": "Play / Pause"},
        {"key": "F6", "action": "Mute / unmute mic"},
        {"key": "F7", "action": "Volume down"},
        {"key": "F8", "action": "Volume up"},
    ],
    "mouse": {name: NONE for name in MOUSE},
    "autostart": False,
}


def load():
    cfg = json.loads(json.dumps(DEFAULTS))
    try:
        with open(CONFIG) as f:
            data = json.load(f)
        if isinstance(data, list) and len(data) == 4:  # config from the first version
            cfg["keys"] = data
        elif isinstance(data, dict):
            if len(data.get("keys", [])) == 4:
                cfg["keys"] = data["keys"]
            cfg["mouse"].update({k: v for k, v in data.get("mouse", {}).items() if k in MOUSE})
            cfg["autostart"] = bool(data.get("autostart", False))
    except (OSError, ValueError):
        pass
    return cfg


def save(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)


def gset(schema, key, value):
    subprocess.run(["gsettings", "set", schema, key, value], check=True)


def apply_keys(rows):
    """Write Cinnamon custom keybindings, leaving other custom shortcuts alone."""
    current = subprocess.run(
        ["gsettings", "get", KB_ROOT, "custom-list"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    existing = [s for s in ast.literal_eval(current.replace("@as ", "")) if not s.startswith(PREFIX)]
    names = []
    for i, row in enumerate(rows):
        cmd = ACTIONS.get(row["action"])
        if not cmd:
            continue
        name = f"{PREFIX}{i + 1}"
        schema = f"{KB_ROOT}.custom-keybinding:{KB_PATH}{name}/"
        gset(schema, "name", f"Fingertip Control: {row['action']}")
        gset(schema, "command", cmd)
        gset(schema, "binding", str([row["key"]]))
        names.append(name)
    gset(KB_ROOT, "custom-list", str(existing + names))


def apply_mouse(mouse):
    """Mouse buttons are handled by xbindkeys (X11), using a config file of our own."""
    subprocess.run(["pkill", "-f", f"xbindkeys -f {XBINDKEYS_RC}"], check=False)
    lines = []
    for name, button in MOUSE.items():
        cmd = ACTIONS.get(mouse.get(name, NONE))
        if cmd:
            lines.append(f'"{cmd}"\n  b:{button}\n')
    if not lines:
        return
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(XBINDKEYS_RC, "w") as f:
        f.write("\n".join(lines))
    subprocess.Popen(["xbindkeys", "-f", XBINDKEYS_RC], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def set_autostart(on):
    if on:
        os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
        with open(AUTOSTART, "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Fingertip Control\n"
                    f"Exec={os.path.realpath(__file__)} --apply\nIcon=fingertip-control\n"
                    "X-GNOME-Autostart-enabled=true\n")
    elif os.path.exists(AUTOSTART):
        os.remove(AUTOSTART)


def apply_all(cfg):
    apply_keys(cfg["keys"])
    apply_mouse(cfg["mouse"])
    set_autostart(cfg["autostart"])
    save(cfg)


def update():
    """Update by pulling the latest version from GitHub (works when installed from a git clone)."""
    here = os.path.dirname(os.path.realpath(__file__))
    if not os.path.isdir(os.path.join(here, ".git")):
        return False, "Not a git clone. Get the latest from github.com/DanielCohen002/fingertip-control."
    r = subprocess.run(["git", "-C", here, "pull", "--ff-only"], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        return False, "Update failed: " + (r.stderr.strip().splitlines() or ["unknown error"])[-1]
    return "Already up to date" not in r.stdout, "Already up to date." if "Already up to date" in r.stdout else "Updated. Restarting..."


def run_gui():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk

    class Window(Gtk.Window):
        def __init__(self):
            super().__init__(title="Fingertip Control")
            icon = os.path.join(os.path.dirname(os.path.realpath(__file__)), "assets", "logo.png")
            if os.path.exists(icon):
                self.set_icon_from_file(icon)
            self.set_border_width(14)
            self.set_resizable(False)
            cfg = load()
            names = list(ACTIONS)
            grid = Gtk.Grid(column_spacing=12, row_spacing=8)
            self.add(grid)

            def header(text, row):
                lbl = Gtk.Label(xalign=0)
                lbl.set_markup(f"<b>{text}</b>")
                grid.attach(lbl, 0, row, 2, 1)

            def action_box(current):
                box = Gtk.ComboBoxText()
                for a in names:
                    box.append_text(a)
                box.set_active(names.index(current) if current in names else 0)
                return box

            header("Keyboard", 0)
            self.key_rows = []
            for i, row in enumerate(cfg["keys"]):
                key_box = Gtk.ComboBoxText()
                for k in KEYS:
                    key_box.append_text(k)
                key_box.set_active(KEYS.index(row["key"]) if row["key"] in KEYS else 0)
                act_box = action_box(row["action"])
                grid.attach(key_box, 0, i + 1, 1, 1)
                grid.attach(act_box, 1, i + 1, 1, 1)
                self.key_rows.append((key_box, act_box))

            header("Mouse buttons", 6)
            self.mouse_rows = {}
            for i, name in enumerate(MOUSE):
                grid.attach(Gtk.Label(label=name, xalign=0), 0, 7 + i, 1, 1)
                box = action_box(cfg["mouse"][name])
                grid.attach(box, 1, 7 + i, 1, 1)
                self.mouse_rows[name] = box

            self.auto = Gtk.CheckButton(label="Start at login")
            self.auto.set_active(cfg["autostart"])
            grid.attach(self.auto, 0, 10, 2, 1)

            bar = Gtk.Box(spacing=8)
            for label, handler in (("Apply", self.on_apply), ("Reset to defaults", self.on_reset), ("Update", self.on_update)):
                b = Gtk.Button(label=label)
                b.connect("clicked", handler)
                bar.pack_start(b, False, False, 0)
            grid.attach(bar, 0, 11, 2, 1)
            self.status = Gtk.Label(label="", xalign=0)
            grid.attach(self.status, 0, 12, 2, 1)

        def current(self):
            return {
                "keys": [{"key": k.get_active_text(), "action": a.get_active_text()} for k, a in self.key_rows],
                "mouse": {n: b.get_active_text() for n, b in self.mouse_rows.items()},
                "autostart": self.auto.get_active(),
            }

        def on_apply(self, _):
            cfg = self.current()
            keys = [r["key"] for r in cfg["keys"] if ACTIONS.get(r["action"])]
            if len(keys) != len(set(keys)):
                self.status.set_text("Each key can only be used once.")
                return
            try:
                apply_all(cfg)
                self.status.set_text("Applied.")
            except Exception as e:  # noqa: BLE001
                self.status.set_text(f"Failed: {e}")

        def on_update(self, _):
            try:
                changed, msg = update()
            except Exception as e:  # noqa: BLE001
                changed, msg = False, f"Update failed: {e}"
            self.status.set_text(f"{msg} (v{VERSION})" if not changed else msg)
            if changed:
                self.hide()
                os.execv(sys.executable, [sys.executable, os.path.realpath(__file__)])

        def on_reset(self, _):
            names = list(ACTIONS)
            for (k, a), d in zip(self.key_rows, DEFAULTS["keys"]):
                k.set_active(KEYS.index(d["key"]))
                a.set_active(names.index(d["action"]))
            for box in self.mouse_rows.values():
                box.set_active(0)
            self.auto.set_active(False)

    win = Window()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    if "--apply" in sys.argv:  # used at login: restore everything without opening the window
        cfg = load()
        apply_keys(cfg["keys"])
        apply_mouse(cfg["mouse"])
    else:
        run_gui()
