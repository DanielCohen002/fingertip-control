#!/usr/bin/env python3
"""Fingertip Control: remap F-keys and mouse buttons to simple actions on Linux Mint (Cinnamon, X11)."""
import ast
import json
import os
import re
import shlex
import subprocess
import sys

CONFIG_DIR = os.path.expanduser("~/.config/key-shortcuts")
CONFIG = os.path.join(CONFIG_DIR, "config.json")
XBINDKEYS_RC = os.path.join(CONFIG_DIR, "xbindkeysrc")
AUTOSTART = os.path.expanduser("~/.config/autostart/fingertip-control.desktop")
KB_ROOT = "org.cinnamon.desktop.keybindings"
KB_PATH = "/org/cinnamon/desktop/keybindings/custom-keybindings/"
PREFIX = "keyshortcut"
VERSION = "1.4.0"

NONE = "None (leave as is)"
CUSTOM = "Custom key combo"
ACTIONS = {
    NONE: None,
    "Play / Pause": "xdotool key XF86AudioPlay",
    "Next track": "xdotool key XF86AudioNext",
    "Previous track": "xdotool key XF86AudioPrev",
    "Stop": "xdotool key XF86AudioStop",
    "Mute / unmute speakers": "xdotool key XF86AudioMute",
    "Volume up": "xdotool key XF86AudioRaiseVolume",
    "Volume down": "xdotool key XF86AudioLowerVolume",
    "Mute / unmute mic": "xdotool key XF86AudioMicMute",
    "Mic volume up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
    "Mic volume down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
    "Copy": "xdotool key ctrl+c",
    "Paste": "xdotool key ctrl+v",
    "Undo": "xdotool key ctrl+z",
    "Clipboard history": "gpaste-client ui",
    "Browser back": "xdotool key alt+Left",
    "Browser forward": "xdotool key alt+Right",
    "Middle click": "xdotool click 2",
    "Double click": "xdotool click --repeat 2 --delay 60 1",
    CUSTOM: None,
    "Disable this button": "true",
}
MODS = {"ctrl": "ctrl", "control": "ctrl", "alt": "alt", "shift": "shift", "win": "super", "windows": "super", "super": "super"}
NAMED = {"enter": "Return", "return": "Return", "esc": "Escape", "escape": "Escape", "tab": "Tab", "space": "space",
         "delete": "Delete", "del": "Delete", "backspace": "BackSpace", "home": "Home", "end": "End",
         "pageup": "Prior", "pagedown": "Next", "insert": "Insert", "left": "Left", "right": "Right", "up": "Up", "down": "Down"}
HELP = ("Custom key combo: type keys joined with +, like ctrl+shift+t or alt+left.\n"
        "Modifiers: ctrl, alt, shift, win.  Keys: a-z, 0-9, f1-f12, enter, esc, tab, space, delete,\n"
        "backspace, home, end, pageup, pagedown, left, right, up, down.")
KEYS = [f"F{i}" for i in range(1, 13)] + ["PageUp", "PageDown", "LeftAlt", "RightAlt"]
KEYSYM = {"PageUp": "Prior", "PageDown": "Next", "LeftAlt": "Alt_L", "RightAlt": "Alt_R"}  # others: the name itself
MOUSE = {"Middle button": 2, "Back button": 8, "Forward button": 9}  # X11 button numbers
DEFAULTS = {
    "keys": [
        {"key": "F5", "action": "Play / Pause"},
        {"key": "F6", "action": "Mute / unmute mic"},
        {"key": "F7", "action": "Volume down"},
        {"key": "F8", "action": "Volume up"},
    ],
    "mouse": {name: NONE for name in MOUSE},
    "autostart": False,
}


def load():
    cfg = json.loads(json.dumps(DEFAULTS))
    try:
        with open(CONFIG) as f:
            data = json.load(f)
        if isinstance(data, list) and len(data) == 4:  # config from the first version
            cfg["keys"] = data
        elif isinstance(data, dict):
            if len(data.get("keys", [])) == 4:
                cfg["keys"] = data["keys"]
            cfg["mouse"].update({k: v for k, v in data.get("mouse", {}).items() if k in MOUSE})
            cfg["autostart"] = bool(data.get("autostart", False))
    except (OSError, ValueError):
        pass
    return cfg


def save(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG, "w") as f:
        json.dump(cfg, f, indent=2)


def parse_combo(text):
    """'ctrl+shift+t' -> xdotool key names. Raises ValueError if unclear."""
    parts = [p for p in text.lower().replace(" ", "").split("+") if p]
    if not parts:
        raise ValueError("type a combo like ctrl+shift+t")
    keys = []
    for p in parts:
        if p in MODS:
            keys.append(MODS[p])
        elif p in NAMED:
            keys.append(NAMED[p])
        elif re.fullmatch(r"f([1-9]|1[0-2])", p):
            keys.append(p.upper())
        elif re.fullmatch(r"[a-z0-9]", p):
            keys.append(p)
        else:
            raise ValueError(f"unknown key '{p}'")
    if all(k in MODS.values() for k in keys):
        raise ValueError("add a normal key, like ctrl+c")
    return sorted(keys, key=lambda k: k not in MODS.values())


def command_for(action):
    """The shell command for an action name, or None for 'leave as is'."""
    if action.startswith("Custom:"):
        try:
            return "xdotool key --clearmodifiers " + "+".join(parse_combo(action[7:]))
        except ValueError:
            return None
    return ACTIONS.get(action)


def gset(schema, key, value):
    subprocess.run(["gsettings", "set", schema, key, value], check=True)


def apply_keys(rows):
    """Register Cinnamon custom keybindings that call back into this script (--run KEY).

    The saved config is read when a key is pressed, so changing an action takes effect at once.
    Cinnamon never unloads a shortcut until it restarts, so if a key was freed or old-style
    shortcuts need replacing, this returns True and the caller restarts Cinnamon.
    """
    current = subprocess.run(
        ["gsettings", "get", KB_ROOT, "custom-list"],
        capture_output=True, text=True, check=True,
    ).stdout.strip()
    all_ids = ast.literal_eval(current.replace("@as ", ""))
    others = [i for i in all_ids if not i.startswith(PREFIX)]
    old_ours = [i for i in all_ids if i.startswith(PREFIX)]
    me = shlex.quote(os.path.realpath(__file__))
    wanted = {}
    for row in rows:
        if command_for(row["action"]):
            wanted[f"{PREFIX}-{row['key']}"] = row["key"]
    for name, key in wanted.items():
        schema = f"{KB_ROOT}.custom-keybinding:{KB_PATH}{name}/"
        gset(schema, "name", f"Fingertip Control: {key}")
        gset(schema, "command", f"{me} --run {key}")
        gset(schema, "binding", str([KEYSYM.get(key, key)]))
    gset(KB_ROOT, "custom-list", str(others + list(wanted)))
    return any(i not in wanted for i in old_ours)


def run_key(key):
    """Called by Cinnamon when a bound key is pressed: do the action saved for that key."""
    for row in load()["keys"]:
        if row["key"] == key:
            cmd = command_for(row["action"])
            if cmd:
                subprocess.Popen(cmd, shell=True, start_new_session=True)
            return


def restart_cinnamon():
    subprocess.Popen(["cinnamon", "--replace"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply_mouse(mouse):
    """Mouse buttons are handled by xbindkeys (X11), using a config file of our own."""
    subprocess.run(["pkill", "-f", f"xbindkeys -f {XBINDKEYS_RC}"], check=False)
    lines = []
    for name, button in MOUSE.items():
        cmd = command_for(mouse.get(name, NONE))
        if cmd:
            lines.append(f'"{cmd}"\n  b:{button}\n')
    if not lines:
        return
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(XBINDKEYS_RC, "w") as f:
        f.write("\n".join(lines))
    subprocess.Popen(["xbindkeys", "-f", XBINDKEYS_RC], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def set_autostart(on):
    if on:
        os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
        with open(AUTOSTART, "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Fingertip Control\n"
                    f"Exec={os.path.realpath(__file__)} --minimized\nIcon=fingertip-control\n"
                    "X-GNOME-Autostart-enabled=true\n")
    elif os.path.exists(AUTOSTART):
        os.remove(AUTOSTART)


def apply_all(cfg):
    """Apply everything. Returns True if Cinnamon was restarted to release old shortcuts."""
    save(cfg)  # first, because the key dispatcher reads this file
    restart = apply_keys(cfg["keys"])
    apply_mouse(cfg["mouse"])
    set_autostart(cfg["autostart"])
    if restart:
        restart_cinnamon()
    return restart


def update():
    """Update by pulling the latest version from GitHub (works when installed from a git clone)."""
    here = os.path.dirname(os.path.realpath(__file__))
    if not os.path.isdir(os.path.join(here, ".git")):
        return False, "Not a git clone. Get the latest from github.com/DanielCohen002/fingertip-control."
    r = subprocess.run(["git", "-C", here, "pull", "--ff-only"], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        return False, "Update failed: " + (r.stderr.strip().splitlines() or ["unknown error"])[-1]
    return "Already up to date" not in r.stdout, "Already up to date." if "Already up to date" in r.stdout else "Updated. Restarting..."


def run_gui():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk

    class Window(Gtk.Window):
        def __init__(self):
            super().__init__(title="Fingertip Control")
            icon = os.path.join(os.path.dirname(os.path.realpath(__file__)), "assets", "logo.png")
            if os.path.exists(icon):
                self.set_icon_from_file(icon)
            self.set_border_width(14)
            self.set_resizable(False)
            cfg = load()
            names = list(ACTIONS)
            grid = Gtk.Grid(column_spacing=12, row_spacing=8)
            self.add(grid)

            def header(text, row):
                lbl = Gtk.Label(xalign=0)
                lbl.set_markup(f"<b>{text}</b>")
                grid.attach(lbl, 0, row, 2, 1)

            class ActionPicker(Gtk.Box):
                """Action dropdown plus a text box used when 'Custom key combo' is chosen."""

                def __init__(self, value):
                    super().__init__(spacing=6)
                    self.combo = Gtk.ComboBoxText()
                    for a in names:
                        self.combo.append_text(a)
                    self.entry = Gtk.Entry()
                    self.entry.set_width_chars(16)
                    self.entry.set_placeholder_text("e.g. ctrl+shift+t")
                    self.pack_start(self.combo, False, False, 0)
                    self.pack_start(self.entry, False, False, 0)
                    self.combo.connect("changed", lambda *_: self.entry.set_sensitive(self.combo.get_active_text() == CUSTOM))
                    self.set(value)

                def get(self):
                    if self.combo.get_active_text() == CUSTOM:
                        return "Custom: " + self.entry.get_text().strip()
                    return self.combo.get_active_text()

                def set(self, value):
                    if value.startswith("Custom:"):
                        self.combo.set_active(names.index(CUSTOM))
                        self.entry.set_text(value[7:].strip())
                    else:
                        self.combo.set_active(names.index(value) if value in names else 0)
                        self.entry.set_text("")

            action_box = ActionPicker

            header("Keyboard", 0)
            self.key_rows = []
            for i, row in enumerate(cfg["keys"]):
                key_box = Gtk.ComboBoxText()
                for k in KEYS:
                    key_box.append_text(k)
                key_box.set_active(KEYS.index(row["key"]) if row["key"] in KEYS else 0)
                act_box = action_box(row["action"])
                grid.attach(key_box, 0, i + 1, 1, 1)
                grid.attach(act_box, 1, i + 1, 1, 1)
                self.key_rows.append((key_box, act_box))

            header("Mouse buttons", 6)
            self.mouse_rows = {}
            for i, name in enumerate(MOUSE):
                grid.attach(Gtk.Label(label=name, xalign=0), 0, 7 + i, 1, 1)
                box = action_box(cfg["mouse"][name])
                grid.attach(box, 1, 7 + i, 1, 1)
                self.mouse_rows[name] = box

            help_lbl = Gtk.Label(xalign=0)
            help_lbl.set_markup(f"<small>{HELP}</small>")
            grid.attach(help_lbl, 0, 10, 2, 1)
            self.auto = Gtk.CheckButton(label="Start at login")
            self.auto.set_active(cfg["autostart"])
            grid.attach(self.auto, 0, 11, 2, 1)

            bar = Gtk.Box(spacing=8)
            for label, handler in (("Apply", self.on_apply), ("Reset to defaults", self.on_reset), ("Update", self.on_update)):
                b = Gtk.Button(label=label)
                b.connect("clicked", handler)
                bar.pack_start(b, False, False, 0)
            grid.attach(bar, 0, 12, 2, 1)
            self.status = Gtk.Label(label="", xalign=0)
            grid.attach(self.status, 0, 13, 2, 1)

        def current(self):
            return {
                "keys": [{"key": k.get_active_text(), "action": a.get()} for k, a in self.key_rows],
                "mouse": {n: b.get() for n, b in self.mouse_rows.items()},
                "autostart": self.auto.get_active(),
            }

        def on_apply(self, _):
            cfg = self.current()
            for what, action in [(r["key"], r["action"]) for r in cfg["keys"]] + list(cfg["mouse"].items()):
                if action.startswith("Custom:"):
                    try:
                        parse_combo(action[7:])
                    except ValueError as e:
                        self.status.set_text(f"{what}: {e}")
                        return
            keys = [r["key"] for r in cfg["keys"] if command_for(r["action"])]
            if len(keys) != len(set(keys)):
                self.status.set_text("Each key can only be used once.")
                return
            try:
                restarted = apply_all(cfg)
                self.status.set_text("Applied. Refreshing the desktop to release old keys..." if restarted else "Applied.")
            except Exception as e:  # noqa: BLE001
                self.status.set_text(f"Failed: {e}")

        def on_update(self, _):
            try:
                changed, msg = update()
            except Exception as e:  # noqa: BLE001
                changed, msg = False, f"Update failed: {e}"
            self.status.set_text(f"{msg} (v{VERSION})" if not changed else msg)
            if changed:
                self.hide()
                os.execv(sys.executable, [sys.executable, os.path.realpath(__file__)])

        def on_reset(self, _):
            names = list(ACTIONS)
            for (k, a), d in zip(self.key_rows, DEFAULTS["keys"]):
                k.set_active(KEYS.index(d["key"]))
                a.set(d["action"])
            for box in self.mouse_rows.values():
                box.set(NONE)
            self.auto.set_active(False)

    class TrayApp(Gtk.Application):
        """Single instance. Closing the window hides it; the app keeps running in the tray."""

        def __init__(self):
            super().__init__(application_id="io.github.danielcohen002.FingertipControl")
            self.win = None
            self.first = True

        def do_startup(self):
            Gtk.Application.do_startup(self)
            self.hold()  # stay alive with no window open
            self.win = Window()
            self.win.connect("delete-event", lambda w, e: w.hide_on_delete())
            self.make_tray()
            if "--minimized" in sys.argv:  # started at login: restore remaps quietly
                try:
                    cfg = load()
                    apply_keys(cfg["keys"])
                    apply_mouse(cfg["mouse"])
                except Exception:  # noqa: BLE001
                    pass

        def do_activate(self):
            if self.first and "--minimized" in sys.argv:
                self.first = False
                return
            self.first = False
            self.show_window()

        def show_window(self, *_):
            self.win.show_all()
            self.win.present()

        def toggle_window(self, *_):
            if self.win.get_visible():
                self.win.hide()
            else:
                self.show_window()

        def make_tray(self):
            logo = os.path.join(os.path.dirname(os.path.realpath(__file__)), "assets", "logo.png")
            menu = Gtk.Menu()
            for label, handler in (("Show Fingertip Control", self.show_window), ("Quit", lambda *_: self.quit())):
                item = Gtk.MenuItem(label=label)
                item.connect("activate", handler)
                menu.append(item)
            menu.show_all()
            try:
                gi.require_version("XApp", "1.0")
                from gi.repository import XApp
                self.tray = XApp.StatusIcon()
                self.tray.set_icon_name(logo)
                self.tray.set_tooltip_text("Fingertip Control")
                self.tray.set_secondary_menu(menu)
                self.tray.connect("activate", self.toggle_window)
            except (ValueError, ImportError):
                self.tray = Gtk.StatusIcon.new_from_file(logo)
                self.tray.set_tooltip_text("Fingertip Control")
                self.tray.connect("activate", self.toggle_window)
                self.tray.connect("popup-menu", lambda i, b, t: menu.popup(None, None, Gtk.StatusIcon.position_menu, i, b, t))

    TrayApp().run([sys.argv[0]])


if __name__ == "__main__":
    if "--run" in sys.argv:  # called by Cinnamon when a bound key is pressed
        run_key(sys.argv[sys.argv.index("--run") + 1])
    elif "--apply" in sys.argv:  # restore everything without opening the window
        cfg = load()
        apply_keys(cfg["keys"])
        apply_mouse(cfg["mouse"])
    else:
        run_gui()
